<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <FontFamily x:Key="DashboardFont">Noto Serif SC, KaiTi</FontFamily>
    <FontFamily x:Key="DashboardMonoFont">Noto Serif SC, KaiTi</FontFamily>

    <SolidColorBrush x:Key="DashboardBackground" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardPanel" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardBorder" Color="#E5E5E5" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardText" Color="#111111" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardMuted" Color="#666666" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardSubtle" Color="#999999" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardGreen" Color="#1F7A45" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardGreenSoft" Color="#E8F5EE" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardBlue" Color="#1D6FB8" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardBlueSoft" Color="#E7F2FB" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardPink" Color="#C43B5C" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardPinkSoft" Color="#FDECEF" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardOrange" Color="#C56A00" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardOrangeSoft" Color="#FFF3E4" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardViolet" Color="#6B4FB5" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardTrack" Color="#F0F0F0" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardSegment" Color="#F3F3F3" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardDanger" Color="#C62828" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardHover" Color="#EAEAEA" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardPressed" Color="#DEDEDE" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardPopup" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardKnob" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardScroll" Color="#BDBDBD" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardShadow" Color="#1F000000" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardSelection" Color="#661F7A45" po:Freeze="False" />
    <SolidColorBrush x:Key="DashboardFocus" Color="#991F7A45" po:Freeze="False" />

    <Style TargetType="TextBox">
        <Setter Property="CaretBrush" Value="{DynamicResource DashboardText}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="CaretBrush" Value="{DynamicResource DashboardText}" />
        <Setter Property="Foreground" Value="{DynamicResource DashboardText}" />
    </Style>
</ResourceDictionary>
