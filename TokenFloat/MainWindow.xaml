<Window x:Class="TokenFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenFloat"
        Icon="Assets/tokenfloat-cat.png"
        Width="516"
        Height="328"
        MinWidth="516"
        MinHeight="328"
        FontFamily="楷体"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource DashboardMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DashboardText}" />
                    <Setter Property="Background" Value="{DynamicResource DashboardSegment}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource DashboardMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrendMetricButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DashboardMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DashboardHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InkActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashboardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DashboardMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource DashboardGreenSoft}" />
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource DashboardGreen}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkDateTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DashboardPanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashboardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DashboardText}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource DashboardGreen}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource DashboardSelection}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="DateBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DateBorder" Property="BorderBrush" Value="{DynamicResource DashboardFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="{DynamicResource DashboardScroll}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="8" Background="Transparent">
                            <Border x:Name="InkThumb" Width="4" CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DashboardGreen}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DashboardGreen}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InkScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InkScrollRepeatButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource InkScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InkScrollRepeatButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="InkScrollViewerTemplate" TargetType="ScrollViewer">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        Margin="{TemplateBinding Padding}" />
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                           Style="{StaticResource InkScrollBarStyle}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{TemplateBinding VerticalOffset}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
    <Border Margin="16,14,16,18" CornerRadius="18" Background="{DynamicResource DashboardShadow}" IsHitTestVisible="False" />
    <Border x:Name="ShellBorder" Margin="12,8,12,14"
            CornerRadius="16"
            ClipToBounds="True"
            Background="{DynamicResource DashboardBackground}"
            BorderBrush="{DynamicResource DashboardBorder}"
            BorderThickness="1">
        <Grid>
        <Border x:Name="NormalModeBorder"
                CornerRadius="12"
                ClipToBounds="True"
                Background="{DynamicResource DashboardBackground}">
        <Grid x:Name="NormalContent"
              ClipToBounds="True"
              Background="Transparent"
              TextElement.FontFamily="{StaticResource DashboardFont}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" Source="Assets/tokenfloat-cat.png" Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TokenFloat" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashboardText}" />
                        </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SourceStatusText" MaxWidth="185" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource DashboardMuted}" ToolTip="当前已启用的数据来源" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="MinimizeButton_Click" ToolTip="最小化到托盘" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="×" Click="CloseButton_Click" ToolTip="关闭到托盘" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border VerticalAlignment="Center"
                            Background="{DynamicResource DashboardSegment}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OverviewTabButton" Content="总览" Tag="Overview"
                                    Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" VerticalAlignment="Center"/>
                            <Button x:Name="TrendTabButton" Content="趋势" Tag="Trend"
                                    Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" VerticalAlignment="Center"/>
                            <Button x:Name="ModelTabButton" Content="模型" Tag="Model"
                                    Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" VerticalAlignment="Center"/>
                            <Button x:Name="QuotaTabButton" Content="配额" Tag="Quota"
                                    Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center"
                            Background="{DynamicResource DashboardSegment}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TodayButton" Style="{StaticResource PeriodButtonStyle}" Content="今日" Tag="Today" Click="PeriodButton_Click" />
                            <Button x:Name="WeekButton" Style="{StaticResource PeriodButtonStyle}" Content="本周" Tag="Week" Click="PeriodButton_Click" />
                            <Button x:Name="MonthButton" Style="{StaticResource PeriodButtonStyle}" Content="本月" Tag="Month" Click="PeriodButton_Click" />
                            <Button x:Name="CustomRangeButton" Style="{StaticResource PeriodButtonStyle}" Content="自定"
                                    Click="CustomRangeButton_Click" ToolTip="选择任意起止日期" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ModelRankingButton" Grid.Column="3" Height="26" Padding="8,0" Margin="0,0,6,0"
                            Style="{StaticResource InkActionButtonStyle}" Content="排行"
                            Click="ModelRankingButton_Click" ToolTip="查看当前周期模型排行榜" />
                    <Button x:Name="SettingsButton"
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="26"
                            Height="26"
                            Content="⚙"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="SettingsButton_Click"
                            ToolTip="打开设置" />
                </Grid>

                <Grid x:Name="OverviewPage" Grid.Row="2" Margin="0,8,0,0">
                    <Border x:Name="MetricSummaryBorder" Background="{DynamicResource DashboardPanel}"
                            BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <Grid Margin="4,2,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="12,10,8,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource DashboardPink}" VerticalAlignment="Center" />
                                        <TextBlock Text="总 TOKEN" Margin="6,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TotalTokensText" Text="--"
                                                   FontFamily="{StaticResource DashboardMonoFont}" FontSize="28" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardText}"
                                                   ToolTip="已读取的输入与输出 Token 合计；Antigravity 配额不折算 Token" />
                                        <TextBlock x:Name="PrimaryUnitText" Text=" Token" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="TokenCoverageText" Grid.Row="2" Text="统计 Token 数" FontSize="11"
                                               Foreground="{DynamicResource DashboardSubtle}" />
                                </Grid>
                                <Border Grid.Column="1" Margin="0,14" BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1,0,0,0">
                                    <Grid Margin="14,0,8,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource DashboardBlue}" VerticalAlignment="Center" />
                                            <TextBlock Text="总请求" Margin="6,0,0,0" FontSize="11"
                                                       Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="RequestCountText" Grid.Row="1" Text="--" Margin="0,4,0,2"
                                                   FontFamily="{StaticResource DashboardMonoFont}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardText}"
                                                   ToolTip="所选周期内已读取的模型调用次数" />
                                        <TextBlock Grid.Row="2" Text="统计次数" FontSize="11" Foreground="{DynamicResource DashboardSubtle}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Margin="0,14,4,14" BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1,0,0,0">
                                    <Grid Margin="14,0,8,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource DashboardGreen}" VerticalAlignment="Center" />
                                            <TextBlock Text="已知消耗" Margin="6,0,0,0" FontSize="11"
                                                       Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="EstimatedCostText" Grid.Row="1" Text="--" Margin="0,4,0,2"
                                                   FontFamily="{StaticResource DashboardMonoFont}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardText}" />
                                        <TextBlock Grid.Row="2" Text="NewAPI 已扣额度" FontSize="11" Foreground="{DynamicResource DashboardSubtle}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource DashboardBorder}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="RpmCard" Margin="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="RPM" FontSize="11" Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AverageRpmText" Text="--" Margin="8,0,0,0"
                                                   FontFamily="{StaticResource DashboardMonoFont}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                                        <TextBlock Text="次/分" Margin="6,1,0,0" FontSize="11"
                                                   Foreground="{DynamicResource DashboardSubtle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Column="1" Width="1" Background="{DynamicResource DashboardBorder}" />
                                <Grid x:Name="TpmCard" Grid.Column="2" Margin="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="TPM" FontSize="11" Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AverageTpmText" Text="--" Margin="8,0,0,0"
                                                   FontFamily="{StaticResource DashboardMonoFont}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                                        <TextBlock Text="Token/分" Margin="6,1,0,0" FontSize="11"
                                                   Foreground="{DynamicResource DashboardSubtle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="TrendPage" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                <Border Background="{DynamicResource DashboardPanel}"
                        BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1"                         CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.RowSpan="2" Width="8" Height="28" Background="{DynamicResource DashboardGreen}" CornerRadius="4" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="12,0,4,0" Text="消费趋势"
                                       VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DashboardText}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,3,0,0"
                                        Orientation="Horizontal">
                                <TextBlock x:Name="TrendTitleText" Text="今日 · 每时" Margin="0,1,0,0" FontSize="11"
                                           Foreground="{DynamicResource DashboardMuted}" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="TrendModelFilterButton" Margin="10,0,0,0" Height="18" Padding="7,0"
                                        Content="✕ 模型" FontSize="10" Visibility="Collapsed" Cursor="Hand"
                                        Style="{StaticResource TrendMetricButtonStyle}" Foreground="{DynamicResource DashboardOrange}"
                                        Click="TrendModelFilterButton_Click" ToolTip="仅统计该模型，点击取消筛选" />
                                <TextBlock x:Name="TrendTotalText" Text="总计 --" Margin="12,1,0,0" FontSize="11"
                                           Foreground="{DynamicResource DashboardSubtle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrendPeakText" Text="--" Margin="12,1,0,0" FontSize="11"
                                           Foreground="{DynamicResource DashboardGreen}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="2" Background="{DynamicResource DashboardSegment}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TrendTokensButton" Content="Token" Tag="Tokens"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendMetricButton_Click" />
                                        <Button x:Name="TrendRequestsButton" Content="次数" Tag="Requests"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendMetricButton_Click" />
                                        <Button x:Name="TrendCostButton" Content="消耗" Tag="Cost"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendMetricButton_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="2" Background="{DynamicResource DashboardSegment}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TrendBarsButton" Content="柱状" Tag="Bars"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendChartStyleButton_Click" />
                                        <Button x:Name="TrendAreaButton" Content="面积" Tag="Area"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendChartStyleButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource DashboardBorder}" />
                        <Grid Grid.Row="2" Margin="12,6,12,10" ClipToBounds="True">
                            <Canvas x:Name="UsageTrendCanvas" Background="Transparent"
                                    MouseMove="UsageTrendCanvas_MouseMove"
                                    MouseLeave="UsageTrendCanvas_MouseLeave"
                                    ToolTip="查看当前时段的 Token、请求数和 NewAPI 消耗" />
                            <Canvas x:Name="TrendHoverCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                                <Line x:Name="TrendHoverLine" Stroke="{DynamicResource DashboardMuted}" StrokeThickness="1" StrokeDashArray="3,3" />
                                <Ellipse x:Name="TrendHoverDot" Width="7" Height="7"
                                         Fill="{DynamicResource DashboardPanel}" Stroke="{DynamicResource DashboardGreen}" StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <Grid x:Name="ModelPage" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border Background="{DynamicResource DashboardPanel}"
                            BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="ModelPageTitle" Text="模型用量" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DashboardText}" />
                                <TextBlock x:Name="ModelPageSummary" HorizontalAlignment="Right" FontSize="10"
                                           VerticalAlignment="Center" Foreground="{DynamicResource DashboardMuted}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Token · 请求 · 消耗占比 · 输入/输出占比" Margin="0,2,0,4"
                                       FontSize="10" Foreground="{DynamicResource DashboardMuted}" />
                            <ScrollViewer Grid.Row="2"
                                          Template="{StaticResource InkScrollViewerTemplate}"
                                          Padding="0,0,2,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ModelPagePanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="QuotaPage" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border Background="{DynamicResource DashboardPanel}"
                            BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Antigravity 当前配额" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DashboardText}" />
                                <TextBlock x:Name="QuotaUpdatedText" Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                           Foreground="{DynamicResource DashboardMuted}" />
                            </Grid>
                            <TextBlock x:Name="QuotaStatusText" Grid.Row="1" Margin="0,4,0,7" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DashboardMuted}" />
                            <ScrollViewer Grid.Row="2" Template="{StaticResource InkScrollViewerTemplate}"
                                          Padding="0,0,2,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="QuotaModelsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Popup x:Name="CustomRangePopup"
                   PlacementTarget="{Binding ElementName=CustomRangeButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="340" Padding="18,16"
                        Background="{DynamicResource DashboardPanel}"
                        BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="自定日期"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashboardText}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,9"
                                   Text="按需读取更早日志，结束日期包含当天"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource DashboardMuted}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始" Margin="1,0,0,3"
                                           FontFamily="{StaticResource DashboardFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource DashboardMuted}" />
                                <TextBox x:Name="CustomStartDateTextBox"
                                         Style="{StaticResource InkDateTextBoxStyle}"
                                         MaxLength="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="0,18,0,0"
                                       Text="—"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DashboardMuted}" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结束" Margin="1,0,0,3"
                                           FontFamily="{StaticResource DashboardFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource DashboardMuted}" />
                                <TextBox x:Name="CustomEndDateTextBox"
                                         Style="{StaticResource InkDateTextBoxStyle}"
                                         MaxLength="10" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Content="近 7 天" Tag="7"
                                    Margin="0,0,7,0"
                                    Style="{StaticResource InkActionButtonStyle}"
                                    Click="CustomRangePresetButton_Click" />
                            <Button Content="近 30 天" Tag="30"
                                    Style="{StaticResource InkActionButtonStyle}"
                                    Click="CustomRangePresetButton_Click" />
                            <Button x:Name="ApplyCustomRangeButton"
                                    Content="应用"
                                    Margin="7,0,0,0"
                                    Foreground="{DynamicResource DashboardGreen}"
                                    BorderBrush="{DynamicResource DashboardFocus}"
                                    Style="{StaticResource InkActionButtonStyle}"
                                    Click="ApplyCustomRangeButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CustomRangeStatusText"
                                   Grid.Row="4"
                                   Margin="1,8,0,0"
                                   Text="格式：2026-07-30"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource DashboardMuted}" />
                    </Grid>
                </Border>
            </Popup>

            <Popup x:Name="ModelRankingPopup"
                   PlacementTarget="{Binding ElementName=ModelRankingButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="360" MaxHeight="380" Padding="18,16"
                        Background="{DynamicResource DashboardPanel}"
                        BorderBrush="{DynamicResource DashboardBorder}" BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ModelRankingTitle"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashboardText}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,6"
                                   Text="Token · 请求 · 消耗占比 · 输入/输出占比"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource DashboardMuted}" />
                        <ScrollViewer Grid.Row="2" MaxHeight="310"
                                      Template="{StaticResource InkScrollViewerTemplate}"
                                      Padding="0,0,2,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ModelRankingPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        </Border>
        <Grid x:Name="MiniContent" Visibility="Collapsed" Margin="6,4"
              Background="{DynamicResource DashboardBackground}" Cursor="SizeAll"
              ToolTip="双击展开完整面板"
              MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0" VerticalAlignment="Center">
                <TextBlock Text="今日 Token" FontFamily="{StaticResource DashboardFont}"
                           FontSize="10" Foreground="{DynamicResource DashboardMuted}" />
                <TextBlock x:Name="MiniTokensText" Text="--" FontFamily="{StaticResource DashboardMonoFont}"
                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource DashboardText}" />
            </StackPanel>
            <Rectangle Grid.Column="1" Width="1" Height="24" Fill="{DynamicResource DashboardBorder}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="已知消耗" FontFamily="{StaticResource DashboardFont}"
                           FontSize="10" Foreground="{DynamicResource DashboardMuted}" />
                <TextBlock x:Name="MiniCostText" Text="--" FontFamily="{StaticResource DashboardMonoFont}"
                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DashboardGreen}" />
            </StackPanel>
            <Canvas x:Name="MiniIncreaseCanvas"
                    Grid.ColumnSpan="3"
                    ClipToBounds="True"
                    IsHitTestVisible="False" />
        </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
