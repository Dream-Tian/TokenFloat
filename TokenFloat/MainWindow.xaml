<Window x:Class="TokenFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenFloat"
        Icon="Assets/tokenfloat-cat.png"
        Width="500"
        Height="305"
        MinWidth="500"
        MinHeight="305"
        FontFamily="楷体"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <FontFamily x:Key="CalligraphyFont">华文行楷</FontFamily>
        <FontFamily x:Key="BodyFont">楷体</FontFamily>
        <FontFamily x:Key="SealFont">华文隶书</FontFamily>
        <FontFamily x:Key="SerifFont">Noto Serif SC</FontFamily>
        <FontFamily x:Key="DashboardFont">Noto Serif SC, KaiTi</FontFamily>
        <FontFamily x:Key="DashboardMonoFont">Noto Serif SC, KaiTi</FontFamily>

        <SolidColorBrush x:Key="InkDark" Color="#1A1A1A" />
        <SolidColorBrush x:Key="InkStrong" Color="#333333" />
        <SolidColorBrush x:Key="InkLight" Color="#666666" />
        <SolidColorBrush x:Key="InkClear" Color="#999999" />
        <SolidColorBrush x:Key="SealRed" Color="#C41E3A" />
        <SolidColorBrush x:Key="LandscapeGreen" Color="#2E8B57" />
        <SolidColorBrush x:Key="PaperWhite" Color="#F8F5F0" />
        <SolidColorBrush x:Key="DashboardBackground" Color="#FAFBF9" />
        <SolidColorBrush x:Key="DashboardPanel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DashboardBorder" Color="#DDE1DA" />
        <SolidColorBrush x:Key="DashboardText" Color="#20221F" />
        <SolidColorBrush x:Key="DashboardMuted" Color="#7B8178" />
        <SolidColorBrush x:Key="DashboardSubtle" Color="#A5AAA2" />
        <SolidColorBrush x:Key="DashboardGreen" Color="#5F7F4F" />
        <SolidColorBrush x:Key="DashboardBlue" Color="#4C86C6" />
        <SolidColorBrush x:Key="DashboardPink" Color="#E77298" />
        <SolidColorBrush x:Key="DashboardOrange" Color="#F59A32" />

        <DrawingBrush x:Key="PaperTexture"
                      TileMode="Tile"
                      Viewport="0,0,72,72"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,72,72"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup Opacity="0.15">
                    <GeometryDrawing Brush="#16A88E72" Geometry="M 7,13 L 8,13 8,14 7,14 Z" />
                    <GeometryDrawing Brush="#12999999" Geometry="M 42,9 L 58,9.3 58,9.8 42,9.5 Z" />
                    <GeometryDrawing Brush="#10A88E72" Geometry="M 18,48 L 19,48 19,49 18,49 Z" />
                    <GeometryDrawing Brush="#0F777777" Geometry="M 2,65 C 18,64.5 32,65.5 49,65" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource DashboardMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DashboardText}" />
                    <Setter Property="Background" Value="#EEF0EC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource DashboardMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrendMetricButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource DashboardMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9ECE7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InkActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource DashboardMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#F1F3EF" />
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#BCC5B7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkDateTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource DashboardPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource DashboardText}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource DashboardGreen}" />
            <Setter Property="SelectionBrush" Value="#4C8AA174" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="DateBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DateBorder" Property="BorderBrush" Value="#7A5F7F4F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="#88333333" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="8" Background="Transparent">
                            <Border x:Name="InkThumb" Width="4" CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#992E8B57" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#B3C41E3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InkScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InkScrollRepeatButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource InkScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InkScrollRepeatButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="InkScrollViewerTemplate" TargetType="ScrollViewer">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        Margin="{TemplateBinding Padding}" />
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                           Style="{StaticResource InkScrollBarStyle}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{TemplateBinding VerticalOffset}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Border x:Name="ShellBorder" Margin="8"
            CornerRadius="14"
            ClipToBounds="True"
            Background="{StaticResource DashboardBackground}"
            BorderBrush="{StaticResource DashboardBorder}"
            BorderThickness="1">
        <Grid>
        <Grid x:Name="NormalContent"
              ClipToBounds="True"
              Background="{StaticResource DashboardBackground}"
              TextElement.FontFamily="{StaticResource DashboardFont}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="31" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" Source="Assets/tokenfloat-cat.png" Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TokenFloat" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardText}" />
                        <TextBlock Text="NEWAPI USAGE" Margin="10,1,0,0" FontSize="10"
                                   Foreground="{StaticResource DashboardSubtle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="MinimizeButton_Click" ToolTip="最小化到托盘" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="×" Click="CloseButton_Click" ToolTip="关闭到托盘" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#F2F4F0" BorderBrush="{StaticResource DashboardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OverviewTabButton" Content="总览" Tag="Overview"
                                Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" />
                        <Button x:Name="TrendTabButton" Content="趋势" Tag="Trend"
                                Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" />
                        <Button x:Name="ModelTabButton" Content="模型" Tag="Model"
                                Style="{StaticResource PeriodButtonStyle}" Click="NormalTabButton_Click" />
                    </StackPanel>
                </Border>

                <Grid x:Name="OverviewPage" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                <Border x:Name="MetricSummaryBorder" Grid.Row="0" Background="{StaticResource DashboardPanel}"
                        BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Background="#EDF5FB" CornerRadius="6">
                                    <TextBlock Text="#" FontSize="12" Foreground="{StaticResource DashboardBlue}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="总请求" Margin="5,0,0,0" FontSize="10"
                                           Foreground="{StaticResource DashboardMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="RequestCountText" Grid.Row="1" Text="--" Margin="0,8,0,0"
                                       FontFamily="{StaticResource DashboardMonoFont}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource DashboardText}"
                                       ToolTip="所选周期内 NewAPI 消费日志请求数" />
                            <TextBlock Grid.Row="2" Text="统计次数" FontSize="9" Foreground="{StaticResource DashboardSubtle}" />
                        </Grid>
                        <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{StaticResource DashboardBorder}" />

                        <Grid Grid.Column="1" Margin="8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Background="#EEF4EA" CornerRadius="6">
                                    <TextBlock Text="$" FontSize="12" Foreground="{StaticResource DashboardGreen}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="总消耗" Margin="5,0,0,0" FontSize="10"
                                           Foreground="{StaticResource DashboardMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="EstimatedCostText" Grid.Row="1" Text="--" Margin="0,8,0,0"
                                       FontFamily="{StaticResource DashboardMonoFont}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource DashboardText}" />
                            <TextBlock Grid.Row="2" Text="NewAPI 已扣额度" FontSize="9" Foreground="{StaticResource DashboardSubtle}" />
                        </Grid>
                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="{StaticResource DashboardBorder}" />

                        <Grid Grid.Column="2" Margin="8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Background="#FBEFF3" CornerRadius="6">
                                    <TextBlock Text="T" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DashboardPink}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="总 TOKEN 数" Margin="5,0,0,0" FontSize="10"
                                           Foreground="{StaticResource DashboardMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock x:Name="TotalTokensText" Text="--"
                                           FontFamily="{StaticResource DashboardMonoFont}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource DashboardText}"
                                           ToolTip="NewAPI 日志中的总 Token；已去除重复请求" />
                                <TextBlock x:Name="PrimaryUnitText" Text=" Token" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="统计 Token 数" FontSize="9" Foreground="{StaticResource DashboardSubtle}" />
                        </Grid>
                        <Border Grid.Column="2" Width="1" HorizontalAlignment="Right" Background="{StaticResource DashboardBorder}" />

                        <Grid Grid.Column="3" Margin="8,8" ToolTip="平均 RPM = 请求次数 ÷ 所选周期截至当前经过的分钟数">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Background="#EEF4EA" CornerRadius="6">
                                    <TextBlock Text="↗" FontSize="11" Foreground="{StaticResource DashboardGreen}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="平均 RPM" Margin="5,0,0,0" FontSize="10"
                                           Foreground="{StaticResource DashboardMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="AverageRpmText" Grid.Row="1" Text="--" Margin="0,8,0,0"
                                       FontFamily="{StaticResource DashboardMonoFont}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource DashboardText}" />
                            <TextBlock Grid.Row="2" Text="每分钟请求数" FontSize="9" Foreground="{StaticResource DashboardSubtle}" />
                        </Grid>
                        <Border Grid.Column="3" Width="1" HorizontalAlignment="Right" Background="{StaticResource DashboardBorder}" />

                        <Grid Grid.Column="4" Margin="8,8" ToolTip="平均 TPM = 原始 Token 用量 ÷ 所选周期截至当前经过的分钟数">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Background="#FFF4E7" CornerRadius="6">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="{StaticResource DashboardOrange}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="平均 TPM" Margin="5,0,0,0" FontSize="10"
                                           Foreground="{StaticResource DashboardMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="AverageTpmText" Grid.Row="1" Text="--" Margin="0,8,0,0"
                                       FontFamily="{StaticResource DashboardMonoFont}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource DashboardText}" />
                            <TextBlock Grid.Row="2" Text="每分钟 Token 数" FontSize="9" Foreground="{StaticResource DashboardSubtle}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="OverviewRangeBorder" Grid.Row="1" Background="{StaticResource DashboardPanel}"
                        BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#EEF4EA" CornerRadius="6">
                                <TextBlock Text="◷" FontSize="13" Foreground="{StaticResource DashboardGreen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="统计范围" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DashboardText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Margin="12,0" Padding="2" VerticalAlignment="Center"
                                Background="#F2F4F0" BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1" CornerRadius="7">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TodayButton" Style="{StaticResource PeriodButtonStyle}" Content="今日" Tag="Today" Click="PeriodButton_Click" />
                                <Button x:Name="WeekButton" Style="{StaticResource PeriodButtonStyle}" Content="本周" Tag="Week" Click="PeriodButton_Click" />
                                <Button x:Name="MonthButton" Style="{StaticResource PeriodButtonStyle}" Content="本月" Tag="Month" Click="PeriodButton_Click" />
                                <Button x:Name="CustomRangeButton" Style="{StaticResource PeriodButtonStyle}" Content="自定"
                                        Click="CustomRangeButton_Click" ToolTip="选择任意起止日期" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Height="24" Background="{StaticResource DashboardBorder}" VerticalAlignment="Center" />
                        <Button x:Name="ModelRankingButton" Grid.Column="4" Height="32" Padding="12,0"
                                Style="{StaticResource InkActionButtonStyle}" Content="模型排行"
                                Click="ModelRankingButton_Click" ToolTip="查看当前周期模型排行榜" />
                    </Grid>
                </Border>

                </Grid>

                <Grid x:Name="TrendPage" Grid.Row="2" Visibility="Collapsed">
                <Border Background="{StaticResource DashboardPanel}"
                        BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#EEF4EA" CornerRadius="7" VerticalAlignment="Center">
                                <TextBlock Text="▥" FontSize="14" Foreground="{StaticResource DashboardGreen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,4,0" MaxWidth="205"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="消费趋势" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource DashboardText}" />
                                <TextBlock x:Name="TrendTitleText" Text="今日 · 每时" Margin="10,1,0,0" FontSize="11"
                                           Foreground="{StaticResource DashboardMuted}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrendTotalText" Text="总计 --" Margin="12,1,0,0" FontSize="11"
                                           Foreground="{StaticResource DashboardSubtle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrendPeakText" Text="--" Margin="12,1,0,0" FontSize="11"
                                           Foreground="{StaticResource DashboardGreen}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="2" Background="#F2F4F0" BorderBrush="{StaticResource DashboardBorder}"
                                        BorderThickness="1" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TrendTokensButton" Content="Token" Tag="Tokens"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendMetricButton_Click" />
                                        <Button x:Name="TrendCostButton" Content="消耗" Tag="Cost"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendMetricButton_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="2" Background="#F2F4F0" BorderBrush="{StaticResource DashboardBorder}"
                                        BorderThickness="1" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TrendBarsButton" Content="柱状" Tag="Bars"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendChartStyleButton_Click" />
                                        <Button x:Name="TrendAreaButton" Content="面积" Tag="Area"
                                                Style="{StaticResource TrendMetricButtonStyle}" Click="TrendChartStyleButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource DashboardBorder}" />
                        <Grid Grid.Row="2" Margin="12,6,12,10" ClipToBounds="True">
                            <Canvas x:Name="UsageTrendCanvas" Background="Transparent"
                                    MouseMove="UsageTrendCanvas_MouseMove"
                                    MouseLeave="UsageTrendCanvas_MouseLeave"
                                    ToolTip="查看当前时段的 Token、请求数和 NewAPI 消耗" />
                            <Canvas x:Name="TrendHoverCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                                <Line x:Name="TrendHoverLine" Stroke="#80868D83" StrokeThickness="1" StrokeDashArray="3,3" />
                                <Ellipse x:Name="TrendHoverDot" Width="7" Height="7"
                                         Fill="{StaticResource DashboardPanel}" Stroke="{StaticResource DashboardGreen}" StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <Grid x:Name="ModelPage" Grid.Row="2" Visibility="Collapsed">
                    <Border Background="{StaticResource DashboardPanel}"
                            BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="14,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="ModelPageTitle" Text="模型用量" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource DashboardText}" />
                                <TextBlock x:Name="ModelPageSummary" HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource DashboardMuted}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Token · 请求 · 消耗占比 · 输入/输出占比" Margin="0,3,0,7"
                                       FontSize="10" Foreground="{StaticResource DashboardMuted}" />
                            <ScrollViewer Grid.Row="2" MaxHeight="128"
                                          Template="{StaticResource InkScrollViewerTemplate}"
                                          Padding="0,0,2,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ModelPagePanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Popup x:Name="CustomRangePopup"
                   PlacementTarget="{Binding ElementName=CustomRangeButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="340" Padding="18,16"
                        Background="{StaticResource DashboardPanel}"
                        BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="自定日期"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardText}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,9"
                                   Text="按需读取更早日志，结束日期包含当天"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource DashboardMuted}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始" Margin="1,0,0,3"
                                           FontFamily="{StaticResource DashboardFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource DashboardMuted}" />
                                <TextBox x:Name="CustomStartDateTextBox"
                                         Style="{StaticResource InkDateTextBoxStyle}"
                                         MaxLength="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="0,18,0,0"
                                       Text="—"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DashboardMuted}" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结束" Margin="1,0,0,3"
                                           FontFamily="{StaticResource DashboardFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource DashboardMuted}" />
                                <TextBox x:Name="CustomEndDateTextBox"
                                         Style="{StaticResource InkDateTextBoxStyle}"
                                         MaxLength="10" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Content="近 7 天" Tag="7"
                                    Margin="0,0,7,0"
                                    Style="{StaticResource InkActionButtonStyle}"
                                    Click="CustomRangePresetButton_Click" />
                            <Button Content="近 30 天" Tag="30"
                                    Style="{StaticResource InkActionButtonStyle}"
                                    Click="CustomRangePresetButton_Click" />
                            <Button x:Name="ApplyCustomRangeButton"
                                    Content="应用"
                                    Margin="7,0,0,0"
                                    Foreground="{StaticResource DashboardGreen}"
                                    BorderBrush="#805F7F4F"
                                    Style="{StaticResource InkActionButtonStyle}"
                                    Click="ApplyCustomRangeButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CustomRangeStatusText"
                                   Grid.Row="4"
                                   Margin="1,8,0,0"
                                   Text="格式：2026-07-30"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource DashboardMuted}" />
                    </Grid>
                </Border>
            </Popup>

            <Popup x:Name="ModelRankingPopup"
                   PlacementTarget="{Binding ElementName=ModelRankingButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="360" MaxHeight="380" Padding="18,16"
                        Background="{StaticResource DashboardPanel}"
                        BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ModelRankingTitle"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardText}" />
                        <TextBlock Grid.Row="1" Margin="0,2,0,6"
                                   Text="Token · 请求 · 消耗占比 · 输入/输出占比"
                                   FontFamily="{StaticResource DashboardFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource DashboardMuted}" />
                        <ScrollViewer Grid.Row="2" MaxHeight="310"
                                      Template="{StaticResource InkScrollViewerTemplate}"
                                      Padding="0,0,2,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ModelRankingPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <Grid x:Name="MiniContent" Visibility="Collapsed" Margin="12,9"
              Background="{StaticResource DashboardBackground}" Cursor="SizeAll"
              ToolTip="双击展开完整面板"
              MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="26" Height="26" Background="#EEF4EA" CornerRadius="7"
                    VerticalAlignment="Center">
                <Image Width="21" Height="21" Source="Assets/tokenfloat-cat.png"
                       Stretch="UniformToFill" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="今日 Token" FontFamily="{StaticResource DashboardFont}"
                           FontSize="10" Foreground="{StaticResource DashboardMuted}" />
                <TextBlock x:Name="MiniTokensText" Text="--" FontFamily="{StaticResource DashboardMonoFont}"
                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DashboardText}" />
            </StackPanel>
            <Rectangle Grid.Column="2" Width="1" Height="32" Fill="{StaticResource DashboardBorder}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Margin="13,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="今日消耗" FontFamily="{StaticResource DashboardFont}"
                           FontSize="10" Foreground="{StaticResource DashboardMuted}" />
                <TextBlock x:Name="MiniCostText" Text="--" FontFamily="{StaticResource DashboardMonoFont}"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DashboardGreen}" />
            </StackPanel>
            <Canvas x:Name="MiniIncreaseCanvas"
                    Grid.ColumnSpan="4"
                    ClipToBounds="True"
                    IsHitTestVisible="False" />
        </Grid>
        </Grid>
    </Border>
</Window>
