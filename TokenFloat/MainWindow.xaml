<Window x:Class="TokenFloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenFloat"
        Icon="Assets/tokenfloat-cat.png"
        Width="370"
        Height="520"
        MinWidth="370"
        MinHeight="520"
        FontFamily="楷体"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <FontFamily x:Key="CalligraphyFont">华文行楷</FontFamily>
        <FontFamily x:Key="BodyFont">楷体</FontFamily>
        <FontFamily x:Key="SealFont">华文隶书</FontFamily>
        <FontFamily x:Key="SerifFont">Noto Serif SC</FontFamily>

        <SolidColorBrush x:Key="InkDark" Color="#1A1A1A" />
        <SolidColorBrush x:Key="InkStrong" Color="#333333" />
        <SolidColorBrush x:Key="InkLight" Color="#666666" />
        <SolidColorBrush x:Key="InkClear" Color="#999999" />
        <SolidColorBrush x:Key="SealRed" Color="#C41E3A" />
        <SolidColorBrush x:Key="LandscapeGreen" Color="#2E8B57" />
        <SolidColorBrush x:Key="PaperWhite" Color="#F8F5F0" />

        <DrawingBrush x:Key="PaperTexture"
                      TileMode="Tile"
                      Viewport="0,0,72,72"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,72,72"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup Opacity="0.15">
                    <GeometryDrawing Brush="#16A88E72" Geometry="M 7,13 L 8,13 8,14 7,14 Z" />
                    <GeometryDrawing Brush="#12999999" Geometry="M 42,9 L 58,9.3 58,9.8 42,9.5 Z" />
                    <GeometryDrawing Brush="#10A88E72" Geometry="M 18,48 L 19,48 19,49 18,49 Z" />
                    <GeometryDrawing Brush="#0F777777" Geometry="M 2,65 C 18,64.5 32,65.5 49,65" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource InkClear}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SealRed}" />
                    <Setter Property="Background" Value="#0DC41E3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource InkLight}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource CalligraphyFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrendMetricButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="17" />
            <Setter Property="MinWidth" Value="25" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#102E8B57" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InkScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="#88333333" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="8" Background="Transparent">
                            <Border x:Name="InkThumb" Width="4" CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#992E8B57" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#B3C41E3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InkScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InkScrollRepeatButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource InkScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InkScrollRepeatButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="InkScrollViewerTemplate" TargetType="ScrollViewer">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        Margin="{TemplateBinding Padding}" />
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                           Style="{StaticResource InkScrollBarStyle}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{TemplateBinding VerticalOffset}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="24"
            Background="{StaticResource PaperWhite}"
            BorderBrush="#381A1A1A"
            BorderThickness="1">
        <Grid>
        <Grid x:Name="NormalContent" ClipToBounds="True">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,354,504" RadiusX="23" RadiusY="23" />
            </Grid.Clip>

            <Rectangle Fill="{StaticResource PaperTexture}" IsHitTestVisible="False" />

            <Canvas IsHitTestVisible="False">
                <Ellipse Width="190" Height="155" Canvas.Left="245" Canvas.Top="-54" Opacity="0.17">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.42,0.48">
                            <GradientStop Color="#88333333" Offset="0" />
                            <GradientStop Color="#22333333" Offset="0.58" />
                            <GradientStop Color="#00333333" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="14" />
                    </Ellipse.Effect>
                </Ellipse>

                <Path Data="M -20,428 C 35,380 67,407 112,365 C 155,325 188,392 229,353 C 273,311 322,372 401,317 L 401,484 L -20,484 Z"
                      Opacity="0.14">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#666666" Offset="0" />
                            <GradientStop Color="#12666666" Offset="0.65" />
                            <GradientStop Color="#00666666" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <BlurEffect Radius="7" />
                    </Path.Effect>
                </Path>

                <Path Data="M -15,453 C 54,429 93,459 145,414 C 185,380 231,436 277,399 C 319,365 354,410 406,378 L 406,484 L -15,484 Z"
                      Opacity="0.18">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E8B57" Offset="0" />
                            <GradientStop Color="#332E8B57" Offset="0.55" />
                            <GradientStop Color="#002E8B57" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Path Data="M 20,129 C 72,123 116,135 172,126 C 225,117 277,130 342,119"
                      Stroke="#301A1A1A" StrokeThickness="1.2" StrokeDashArray="18,5,2,7" />
                <Ellipse Width="7" Height="5" Fill="#401A1A1A" Canvas.Left="340" Canvas.Top="116" />
            </Canvas>

            <Grid Margin="21,15,21,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="65" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="125" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" Margin="0,1,10,0" VerticalAlignment="Top"
                            BorderBrush="#551A1A1A" BorderThickness="1" CornerRadius="4"
                            ClipToBounds="True">
                        <Image Source="Assets/tokenfloat-cat.png" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="用量" FontFamily="{StaticResource CalligraphyFont}"
                                   FontSize="27" Foreground="{StaticResource InkDark}" />
                        <TextBlock Text="L O C A L  ·  T O K E N  ·  R E C O R D S" Margin="2,-2,0,0"
                                   FontFamily="{StaticResource SerifFont}" FontSize="9"
                                   FontWeight="Light"
                                   Foreground="{StaticResource InkClear}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="×" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TodayButton" Grid.Column="0" Style="{StaticResource PeriodButtonStyle}"
                            Content="今日" Tag="Today" Click="PeriodButton_Click" />
                    <Button x:Name="WeekButton" Grid.Column="1" Style="{StaticResource PeriodButtonStyle}"
                            Content="本周" Tag="Week" Click="PeriodButton_Click" />
                    <Button x:Name="MonthButton" Grid.Column="2" Style="{StaticResource PeriodButtonStyle}"
                            Content="本月" Tag="Month" Click="PeriodButton_Click" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.7">
                        <TextBlock Text="观" FontFamily="{StaticResource CalligraphyFont}" FontSize="14"
                                   Foreground="{StaticResource LandscapeGreen}" VerticalAlignment="Center" />
                        <Rectangle Width="21" Height="1" Margin="5,0,0,0" Fill="{StaticResource LandscapeGreen}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="5,4,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.05*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Ellipse Width="112" Height="96" HorizontalAlignment="Left" Margin="-12,1,0,0" Opacity="0.1">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#AA333333" Offset="0" />
                                    <GradientStop Color="#00333333" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <BlurEffect Radius="9" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PeriodTitleText" Text="今日所耗"
                                       FontFamily="{StaticResource CalligraphyFont}" FontSize="16"
                                       Foreground="{StaticResource InkLight}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TotalTokensText" Text="--"
                                           FontFamily="{StaticResource BodyFont}" FontSize="37"
                                           FontWeight="Bold" Foreground="{StaticResource InkDark}"
                                           ToolTip="总用量：输入（含缓存）+ 输出；已去除重复事件" />
                                <TextBlock Text=" Token" Margin="7,0,0,7" VerticalAlignment="Bottom"
                                           FontFamily="{StaticResource SerifFont}" FontSize="10"
                                           Foreground="{StaticResource InkClear}" />
                            </StackPanel>
                            <TextBlock x:Name="ComparisonText"
                                       Margin="1,-2,0,0"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource InkClear}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Column="1" Width="1" Height="78" Fill="#2A1A1A1A" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="入墨" FontFamily="{StaticResource CalligraphyFont}" FontSize="14"
                                   Foreground="{StaticResource InkClear}" />
                        <TextBlock x:Name="InputTokensText" Text="--" Margin="0,0,0,8"
                                   FontFamily="{StaticResource BodyFont}" FontSize="16"
                                   Foreground="{StaticResource SealRed}"
                                   ToolTip="输入量包含缓存读取，与 API usage 原始字段一致" />
                        <TextBlock Text="落笔" FontFamily="{StaticResource CalligraphyFont}" FontSize="14"
                                   Foreground="{StaticResource InkClear}" />
                        <TextBlock x:Name="OutputTokensText" Text="--" Margin="0,1,0,0"
                                   FontFamily="{StaticResource BodyFont}" FontSize="16"
                                   Foreground="{StaticResource LandscapeGreen}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="2,0,2,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="所选周期内去重后的 API 请求事件数">
                        <TextBlock Text="次数" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource CalligraphyFont}" FontSize="13"
                                   Foreground="{StaticResource InkClear}" />
                        <TextBlock x:Name="RequestCountText" Text="--" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource BodyFont}" FontSize="15"
                                   Foreground="{StaticResource InkStrong}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="平均 RPM = 请求次数 ÷ 所选周期截至当前经过的分钟数">
                        <TextBlock Text="平均 RPM" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource CalligraphyFont}" FontSize="13"
                                   Foreground="{StaticResource InkClear}" />
                        <TextBlock x:Name="AverageRpmText" Text="--" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource BodyFont}" FontSize="15"
                                   Foreground="{StaticResource SealRed}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="平均 TPM = 原始 Token 用量 ÷ 所选周期截至当前经过的分钟数">
                        <TextBlock Text="平均 TPM" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource CalligraphyFont}" FontSize="13"
                                   Foreground="{StaticResource InkClear}" />
                        <TextBlock x:Name="AverageTpmText" Text="--" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource BodyFont}" FontSize="15"
                                   Foreground="{StaticResource LandscapeGreen}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="按官方 API 付费层标准价格估算；实际账单可能不同">
                        <TextBlock Text="估算费用" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource CalligraphyFont}" FontSize="12"
                                   Foreground="{StaticResource InkClear}" />
                        <TextBlock x:Name="EstimatedCostText" Text="--" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource BodyFont}" FontSize="14"
                                   Foreground="{StaticResource SealRed}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Margin="2,2,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#201A1A1A" BorderThickness="0,0,0,1"
                            Tag="Codex" Cursor="Hand"
                            ToolTip="单击查看模型明细，双击打开 Codex 桌面应用"
                            MouseLeftButtonDown="CodexRow_MouseLeftButtonDown"
                            MouseLeftButtonUp="ProviderRow_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="3" Height="20" Fill="{StaticResource InkStrong}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Codex" Margin="10,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource SerifFont}" FontSize="14" Foreground="{StaticResource InkStrong}" />
                            <TextBlock x:Name="CodexTokensText" Grid.Column="2" Text="--" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFont}" FontSize="15" Foreground="{StaticResource InkDark}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#201A1A1A" BorderThickness="0,0,0,1"
                            Tag="Claude" Cursor="Hand" MouseLeftButtonUp="ProviderRow_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="3" Height="20" Fill="{StaticResource SealRed}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Claude Code" Margin="10,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource SerifFont}" FontSize="14" Foreground="{StaticResource InkStrong}" />
                            <TextBlock x:Name="ClaudeTokensText" Grid.Column="2" Text="--" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFont}" FontSize="15" Foreground="{StaticResource SealRed}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2"
                            Tag="Gemini" Cursor="Hand" MouseLeftButtonUp="ProviderRow_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="3" Height="20" Fill="{StaticResource LandscapeGreen}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Gemini CLI" Margin="10,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource SerifFont}" FontSize="14" Foreground="{StaticResource InkStrong}" />
                            <TextBlock x:Name="GeminiTokensText" Grid.Column="2" Text="暂无记录" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFont}" FontSize="15" Foreground="{StaticResource LandscapeGreen}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="5" Margin="2,3,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="TrendTitleText" Text="今日 · 每时" FontFamily="{StaticResource CalligraphyFont}"
                                   FontSize="12" Foreground="{StaticResource InkClear}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TrendTokensButton" Content="Token" Tag="Tokens"
                                    Style="{StaticResource TrendMetricButtonStyle}"
                                    Click="TrendMetricButton_Click" />
                            <Button x:Name="TrendCostButton" Content="费用" Tag="Cost"
                                    Style="{StaticResource TrendMetricButtonStyle}"
                                    Click="TrendMetricButton_Click" />
                            <TextBlock x:Name="TrendPeakText" Text="--" Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFont}" FontSize="10"
                                       Foreground="{StaticResource LandscapeGreen}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Canvas x:Name="UsageTrendCanvas"
                                Background="Transparent"
                                MouseMove="UsageTrendCanvas_MouseMove"
                                MouseLeave="UsageTrendCanvas_MouseLeave"
                                ToolTip="移动鼠标查看当前周期的原始 Token 用量" />
                        <Canvas x:Name="TrendHoverCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                            <Line x:Name="TrendHoverLine" Stroke="#662E8B57" StrokeThickness="1"
                                  StrokeDashArray="2,2" />
                            <Ellipse x:Name="TrendHoverDot" Width="6" Height="6"
                                     Fill="{StaticResource PaperWhite}"
                                     Stroke="{StaticResource LandscapeGreen}" StrokeThickness="1.5" />
                        </Canvas>
                    </Grid>
                </Grid>

            </Grid>

            <Popup x:Name="ModelDetailsPopup"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="290" MaxHeight="230" Padding="16,12"
                        Background="{StaticResource PaperWhite}"
                        BorderBrush="#661A1A1A" BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ModelDetailsTitle"
                                   FontFamily="{StaticResource CalligraphyFont}" FontSize="18"
                                   Foreground="{StaticResource InkDark}" />
                        <ScrollViewer Grid.Row="1" MaxHeight="190"
                                      Template="{StaticResource InkScrollViewerTemplate}"
                                      Padding="0,0,2,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ModelDetailsPanel" Margin="0,5,0,0" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <Grid x:Name="MiniContent" Visibility="Collapsed" Margin="13,8"
              Background="Transparent" Cursor="SizeAll"
              ToolTip="双击展开完整面板"
              MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="25" Height="25" Source="Assets/tokenfloat-cat.png"
                   Stretch="UniformToFill" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="今日 Token" FontFamily="{StaticResource CalligraphyFont}"
                           FontSize="11" Foreground="{StaticResource InkClear}" />
                <TextBlock x:Name="MiniTokensText" Text="--" FontFamily="{StaticResource BodyFont}"
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkDark}" />
            </StackPanel>
            <Rectangle Grid.Column="2" Width="1" Height="31" Fill="#281A1A1A"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Margin="13,0,4,0" VerticalAlignment="Center">
