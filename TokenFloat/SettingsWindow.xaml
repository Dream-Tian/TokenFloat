<Window x:Class="TokenFloat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenFloat 设置"
        Icon="Assets/tokenfloat-cat.png"
        Width="380"
        Height="408"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="InkDark" Color="#1A1A1A" />
        <SolidColorBrush x:Key="InkStrong" Color="#333333" />
        <SolidColorBrush x:Key="InkLight" Color="#666666" />
        <SolidColorBrush x:Key="InkClear" Color="#999999" />
        <SolidColorBrush x:Key="SealRed" Color="#C41E3A" />
        <SolidColorBrush x:Key="LandscapeGreen" Color="#2E8B57" />
        <SolidColorBrush x:Key="PaperWhite" Color="#F8F5F0" />

        <DrawingBrush x:Key="PaperTexture"
                      TileMode="Tile"
                      Viewport="0,0,64,64"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,64,64"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup Opacity="0.16">
                    <GeometryDrawing Brush="#13999999" Geometry="M 8,12 L 28,12.2 28,12.6 8,12.4 Z" />
                    <GeometryDrawing Brush="#14A88E72" Geometry="M 46,35 L 47,35 47,36 46,36 Z" />
                    <GeometryDrawing Brush="#0F777777" Geometry="M 3,54 C 20,53.6 39,54.6 58,54" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="InkButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontFamily" Value="楷体" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkLight}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#49333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#142E8B57" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6A2E8B57" />
                                <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
            <Setter Property="FontFamily" Value="楷体" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="42" Height="22">
                                <Border x:Name="Track"
                                        Background="#24333333"
                                        BorderBrush="#44333333"
                                        BorderThickness="1"
                                        CornerRadius="11" />
                                <Ellipse x:Name="Knob"
                                         Width="16"
                                         Height="16"
                                         Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="#F8F5F0" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2E8B57" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2E8B57" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PaperWhite}"
            BorderBrush="#3E333333"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Rectangle Fill="{StaticResource PaperTexture}" IsHitTestVisible="False" />
            <Grid Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel VerticalAlignment="Top"
                                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <TextBlock Text="设置"
                                   FontFamily="华文行楷"
                                   FontSize="25"
                                   Foreground="{StaticResource InkDark}" />
                        <TextBlock x:Name="VersionText"
                                   Margin="1,-1,0,0"
                                   FontFamily="楷体"
                                   FontSize="11"
                                   Foreground="{StaticResource InkClear}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Border Width="29"
                                Height="29"
                                Margin="0,0,10,0"
                                Background="{StaticResource SealRed}"
                                CornerRadius="5">
                            <TextBlock Text="设"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="华文隶书"
                                       FontSize="15"
                                       Foreground="#FFFFF0" />
                        </Border>
                        <Button Width="29"
                                Height="29"
                                Content="×"
                                Click="CloseButton_Click"
                                Style="{StaticResource InkButtonStyle}"
                                Padding="0"
                                FontFamily="Noto Serif SC"
                                FontSize="17"
                                BorderThickness="0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#27333333" />

                <Border Grid.Row="2"
                        Margin="0,16,0,12"
                        Padding="16,14,16,15"
                        Background="#BFFFFFF0"
                        BorderBrush="#302E8B57"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="更新"
                                   FontFamily="华文行楷"
                                   FontSize="19"
                                   Foreground="{StaticResource InkStrong}" />

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <CheckBox x:Name="AutoUpdateCheckBox"
                                      Content="自动检查更新"
                                      Click="AutoUpdateCheckBox_Click"
                                      Style="{StaticResource ToggleStyle}" />
                            <TextBlock Margin="0,3,46,0"
                                       Text="启动后每 24 小时在后台检查一次"
                                       FontFamily="楷体"
                                       FontSize="11"
                                       Foreground="{StaticResource InkClear}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,5"
                                   Text="更新清单地址"
                                   FontFamily="楷体"
                                   FontSize="13"
                                   Foreground="{StaticResource InkLight}" />

                        <Border Grid.Row="3"
                                Height="36"
                                Background="#B8F8F5F0"
                                BorderBrush="#49333333"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBox x:Name="ManifestUrlTextBox"
                                     Margin="9,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource InkStrong}"
                                     FontFamily="Noto Serif SC"
                                     FontSize="11"
                                     TextWrapping="NoWrap" />
                        </Border>

                        <StackPanel Grid.Row="4"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="SaveSourceButton"
                                    Margin="0,0,8,0"
                                    Content="保存"
                                    Click="SaveSourceButton_Click"
                                    Style="{StaticResource InkButtonStyle}" />
                            <Button x:Name="CheckUpdatesButton"
                                    Content="检查更新"
                                    Click="CheckUpdatesButton_Click"
                                    Style="{StaticResource InkButtonStyle}" />
                            <Button x:Name="DownloadUpdateButton"
                                    Margin="8,0,0,0"
                                    Content="下载并安装"
                                    Click="DownloadUpdateButton_Click"
                                    Style="{StaticResource InkButtonStyle}"
                                    Foreground="{StaticResource SealRed}"
                                    BorderBrush="#72C41E3A"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="3"
                           MinHeight="34"
                           Text="设置只保存在本机"
                           TextWrapping="Wrap"
                           FontFamily="楷体"
                           FontSize="12"
                           Foreground="{StaticResource InkClear}" />
            </Grid>
        </Grid>
    </Border>
</Window>
